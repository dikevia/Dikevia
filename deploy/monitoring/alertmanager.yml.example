# Copier en alertmanager.yml puis remplacer les valeurs SMTP avant d'activer les alertes.
global:
  smtp_smarthost: 'smtp.example.org:587'
  smtp_from: 'alertes-juris@example.org'
  smtp_auth_username: 'CHANGE_ME_SMTP_USERNAME'
  smtp_auth_password: 'CHANGE_ME_SMTP_PASSWORD'
  smtp_require_tls: true

route:
  receiver: 'juris-ops-email'
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 2h

receivers:
  - name: 'juris-ops-email'
    email_configs:
      - to: 'administrateur@example.org'
        send_resolved: true
