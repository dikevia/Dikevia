# PostgreSQL application data
COMPOSE_PROJECT_NAME=cfdt-juris
JURIS_RUNTIME_ENV_FILE=../.env.runtime
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
KEYCLOAK_BIND_ADDRESS=127.0.0.1
KEYCLOAK_PORT=8081
POSTGRES_MIGRATION_PASSWORD=CHANGE_ME_MIGRATION
POSTGRES_APP_PASSWORD=CHANGE_ME_RUNTIME
POSTGRES_INGEST_PASSWORD=CHANGE_ME_INGEST
POSTGRES_MONITOR_PASSWORD=CHANGE_ME_MONITOR
POSTGRES_PLATFORM_ADMIN_PASSWORD=CHANGE_ME_PLATFORM_ADMIN
DATABASE_URL=postgresql://cfdt_juris_app:CHANGE_ME_RUNTIME@db:5432/cfdt_juris
LEGAL_CORPUS_INGEST_DATABASE_URL=postgresql://cfdt_juris_ingest:CHANGE_ME_INGEST@db:5432/cfdt_juris
PLATFORM_ADMIN_DATABASE_URL=postgresql://cfdt_juris_platform_admin:CHANGE_ME_PLATFORM_ADMIN@db:5432/cfdt_juris

# Keycloak — use distinct long random passwords; never reuse the DB password.
KEYCLOAK_DB_PASSWORD=CHANGE_ME_KEYCLOAK_DB
KEYCLOAK_ADMIN_USERNAME=kc-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN
# Public URL seen by browsers. In production, use HTTPS behind a reverse proxy.
KEYCLOAK_PUBLIC_URL=http://localhost:8081
KEYCLOAK_PROXY_HEADERS=
# Public URL of the CFDT JURIS web app (no trailing slash).
PUBLIC_APP_URL=http://localhost:8000

# API validates access tokens issued by the imported realm.
APP_ENV=development
DEBUG=false
OIDC_ISSUER=http://localhost:8081/realms/cfdt
OIDC_AUDIENCE=cfdt-juris-api
OIDC_JWKS_URL=http://keycloak:8080/realms/cfdt/protocol/openid-connect/certs
OIDC_ALGORITHMS=RS256
OIDC_PROVIDER=keycloak
OIDC_CLIENT_ID=cfdt-juris-web
OIDC_SCOPES=openid profile email
OIDC_AUTHORIZATION_AUDIENCE=cfdt-juris-api
OIDC_EMAIL_CLAIM=email
OIDC_EMAIL_VERIFIED_CLAIM=email_verified
# Used only during an Auth0 migration that preserves existing Keycloak subject IDs.
# OIDC_IDENTITY_COMPAT_ISSUER=https://dikevia-identity-l2r8.onrender.com/realms/cfdt
# OIDC_IDENTITY_SUBJECT_PREFIX=auth0|
# Public Keycloak client used only to prove control of a legacy account during Auth0 migration.
# OIDC_LEGACY_CLIENT_ID=cfdt-juris-web
CORS_ORIGINS=http://localhost:8000

DOCUMENT_STORAGE_PATH=/var/lib/cfdt-juris/documents
# Neon private object storage (credentials are provisioned per branch; never commit secrets).
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DOCUMENT_STORAGE_BUCKET=cfdt-juris-documents
# CGFP is Dikevia's national baseline; Légifrance checks temporal applicability.
CGFP_ENABLED=true
# Hybrid semantic retrieval is opt-in; keep disabled until client-side embedding is validated.
VECTOR_SEARCH_ENABLED=false
# Optional override for the national CGFP snapshot index.
# CGFP_INDEX_PATH=/srv/corpus_national/index/CGFP_articles_2026-10-31.json
DOCUMENT_MAX_SIZE_MB=20
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=8

# Production example (replace with the real domain names and HTTPS URLs):
# APP_ENV=production
# KEYCLOAK_PUBLIC_URL=https://identite.example.org
# PUBLIC_APP_URL=https://juris.example.org
# OIDC_ISSUER=https://identite.example.org/realms/cfdt
# OIDC_JWKS_URL=https://identite.example.org/realms/cfdt/protocol/openid-connect/certs
# CORS_ORIGINS=https://juris.example.org
# KEYCLOAK_PROXY_HEADERS=xforwarded

# Auth0 migration example (use the exact issuer including its trailing slash):
# OIDC_PROVIDER=auth0
# Development only: configure this exact API identifier in the Auth0 development tenant first.
# OIDC_ISSUER=https://dev-brlgaz1yh2de3mjo.us.auth0.com/
# OIDC_AUDIENCE=urn:dikevia:api:development
# OIDC_JWKS_URL=https://dev-brlgaz1yh2de3mjo.us.auth0.com/.well-known/jwks.json
# OIDC_CLIENT_ID=BSpBdDO3IUyG2g5JcHYH29e80JRbnW41
# OIDC_SCOPES=openid profile email
# OIDC_AUTHORIZATION_AUDIENCE=urn:dikevia:api:development
# OIDC_IDENTITY_COMPAT_ISSUER=https://dikevia-identity-l2r8.onrender.com/realms/cfdt
# OIDC_IDENTITY_SUBJECT_PREFIX=auth0|
# OIDC_EMAIL_CLAIM=email
# OIDC_EMAIL_VERIFIED_CLAIM=email_verified

# Invitations automatiques par e-mail (facultatif).
# Avec Auth0, SMTP et INVITATION_BASE_URL suffisent : Universal Login gère le compte.
# Avec Keycloak, ajouter aussi le client de service Keycloak Admin.
# KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080
# KEYCLOAK_ADMIN_REALM=cfdt
# KEYCLOAK_ADMIN_CLIENT_ID=cfdt-juris-provisioner
# KEYCLOAK_ADMIN_CLIENT_SECRET=
# KEYCLOAK_ADMIN_TIMEOUT_SECONDS=8
# INVITATION_BASE_URL=http://localhost:8000
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# Fournisseur IA facultatif, compatible avec l'API OpenAI Chat Completions.
# Pour éviter le Neon AI Gateway (qui exige un accès/financement spécifique),
# utiliser directement l'API Google AI Studio avec une clé Gemini si disponible.
# Les quotas gratuits Google restent limités et peuvent entraîner des 429/503.
# AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=your-google-ai-studio-key
# AI_MODEL=gemini-2.5-flash
# Modèles Gemini alternatifs après surcharge temporaire (HTTP 503) ou modèle retiré (HTTP 404).
AI_FALLBACK_MODELS=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=25
# Maximum chat requests per authenticated user and organization per minute (1-120).
CHAT_RATE_LIMIT_PER_MINUTE=10

# Légifrance / PISTE — facultatif tant que les identifiants n'ont pas été créés.
# Créer une application distincte pour la sandbox et la production sur PISTE.
LEGIFRANCE_ENVIRONMENT=sandbox
LEGIFRANCE_CLIENT_ID=
LEGIFRANCE_CLIENT_SECRET=
LEGIFRANCE_SCOPE=openid
LEGIFRANCE_TIMEOUT_SECONDS=20
LEGIFRANCE_CODE_NAME=Code général de la fonction publique
# Enable only after validating the CETAT full-text consultation contract in PISTE sandbox.
LEGIFRANCE_CETAT_FULLTEXT_ENABLED=false

# Stripe Billing (optional until commercial launch). Use test keys in staging.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_SUCCESS_URL=http://localhost:8000/?billing=success
BILLING_CANCEL_URL=http://localhost:8000/?billing=cancel

# Monitoring stack (only required when starting deploy/docker-compose.monitoring.yml).
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN

# Chiffrement des sauvegardes de production avec age (clé publique age1...).
# Obligatoire en production ; garder la clé privée hors du serveur.
BACKUP_AGE_RECIPIENT=

# Stripe Tax: configure the business tax registrations in Stripe before enabling live Checkout.
STRIPE_AUTOMATIC_TAX_ENABLED=true

# Instance privée syndicale : 10 comptes Premium gratuits, sans paiement
PRIVATE_INSTANCE_MODE=true
PRIVATE_INSTANCE_MAX_USERS=10

# Temporary global beta account cap; set to 0 only when opening registrations.
BETA_MAX_USERS=1
# External provider probes may consume quotas; disabled unless explicitly approved.
STARTUP_EXTERNAL_DIAGNOSTICS_ENABLED=false
# Local employer documents are never sent to external AI unless both server opt-in and per-request consent are present.
AI_LOCAL_DOCUMENTS_IN_CHAT_ENABLED=false
AI_LOCAL_DOCUMENT_REVIEW_ENABLED=false
# Stripe remains disabled until billing, credit costs and contractual terms are validated.
STRIPE_BILLING_ENABLED=false

