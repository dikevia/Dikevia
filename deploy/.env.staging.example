# PostgreSQL application data
COMPOSE_PROJECT_NAME=cfdt-juris-staging
JURIS_RUNTIME_ENV_FILE=../.env.staging.runtime
API_BIND_ADDRESS=127.0.0.1
API_PORT=18000
KEYCLOAK_BIND_ADDRESS=127.0.0.1
KEYCLOAK_PORT=18081
POSTGRES_MIGRATION_PASSWORD=CHANGE_ME_MIGRATION
POSTGRES_APP_PASSWORD=CHANGE_ME_RUNTIME
POSTGRES_INGEST_PASSWORD=CHANGE_ME_INGEST
POSTGRES_MONITOR_PASSWORD=CHANGE_ME_MONITOR
DATABASE_URL=postgresql://cfdt_juris_app:CHANGE_ME_RUNTIME@db:5432/cfdt_juris
LEGAL_CORPUS_INGEST_DATABASE_URL=postgresql://cfdt_juris_ingest:CHANGE_ME_INGEST@db:5432/cfdt_juris

# Keycloak — use distinct long random passwords; never reuse the DB password.
KEYCLOAK_DB_PASSWORD=CHANGE_ME_KEYCLOAK_DB
KEYCLOAK_ADMIN_USERNAME=kc-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN
# Public URL seen by browsers. In production, use HTTPS behind a reverse proxy.
KEYCLOAK_PUBLIC_URL=https://identite-staging.example.org
KEYCLOAK_PROXY_HEADERS=xforwarded
# Public URL of the CFDT JURIS web app (no trailing slash).
PUBLIC_APP_URL=https://juris-staging.example.org

# API validates access tokens issued by the imported realm.
APP_ENV=production
DEBUG=false
OIDC_ISSUER=https://identite-staging.example.org/realms/cfdt
OIDC_AUDIENCE=cfdt-juris-api
OIDC_JWKS_URL=https://identite-staging.example.org/realms/cfdt/protocol/openid-connect/certs
OIDC_ALGORITHMS=RS256
CORS_ORIGINS=https://juris-staging.example.org

DOCUMENT_STORAGE_PATH=/var/lib/cfdt-juris/documents
# Optional override for the national CGFP snapshot index.
# CGFP_INDEX_PATH=/srv/corpus_national/index/CGFP_articles_2026-10-31.json
DOCUMENT_MAX_SIZE_MB=20
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=8

# STAGING: remplacez les deux domaines example.org et fournissez les clés sandbox/test.
# Déployer derrière un reverse proxy HTTPS ; ne pas exposer directement Keycloak en public.
# KEYCLOAK_PROXY_HEADERS=xforwarded

# Invitations automatiques par e-mail (facultatif).
# Décommenter et renseigner toutes les variables après configuration du client de service Keycloak et du SMTP.
# KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080
# KEYCLOAK_ADMIN_REALM=cfdt
# KEYCLOAK_ADMIN_CLIENT_ID=cfdt-juris-provisioner
# KEYCLOAK_ADMIN_CLIENT_SECRET=
# KEYCLOAK_ADMIN_TIMEOUT_SECONDS=8
# INVITATION_BASE_URL=http://localhost:8000
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# Fournisseur IA facultatif, compatible avec l'API OpenAI Chat Completions.
# Sans ces trois valeurs, JURIS conserve le mode recherche documentaire sans génération IA.
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=your-secret
# AI_MODEL=your-model-id
AI_TIMEOUT_SECONDS=25

# Légifrance / PISTE — facultatif tant que les identifiants n'ont pas été créés.
# Créer une application distincte pour la sandbox et la production sur PISTE.
LEGIFRANCE_ENVIRONMENT=sandbox
LEGIFRANCE_CLIENT_ID=
LEGIFRANCE_CLIENT_SECRET=
LEGIFRANCE_SCOPE=openid
LEGIFRANCE_TIMEOUT_SECONDS=20
LEGIFRANCE_CODE_NAME=Code général de la fonction publique

# Stripe Billing (optional until commercial launch). Use test keys in staging.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_SUCCESS_URL=https://juris-staging.example.org/?billing=success
BILLING_CANCEL_URL=https://juris-staging.example.org/?billing=cancel

# Monitoring stack (only required when starting deploy/docker-compose.monitoring.yml).
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN

# Clé publique age de sauvegarde chiffrée (obligatoire pour la recette).
BACKUP_AGE_RECIPIENT=

# Instance privée syndicale : 10 comptes Premium gratuits, sans paiement
PRIVATE_INSTANCE_MODE=true
PRIVATE_INSTANCE_MAX_USERS=10
